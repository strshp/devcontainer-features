{
    "name": "GitHub CLI",
    "id": "gh",
    "version": "1.4.0",
    "description": "GitHub CLI を導入し、認証情報を Docker ボリュームに永続化します。コンテナ内で gh auth login を一度行えば、再ビルド越しに保持されます。",
    "mounts": [
        {
            "source": "gh-devcontainers",
            "target": "/var/gh-config",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "GH_CONFIG_DIR": "/var/gh-config"
    },
    "postCreateCommand": "sudo -n /usr/local/bin/gh-init",
    "dependsOn": {
        "ghcr.io/devcontainers/features/github-cli": {}
    }
}
