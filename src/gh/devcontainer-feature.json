{
    "name": "GitHub CLI",
    "id": "gh",
    "version": "1.2.2",
    "description": "GitHub CLI の認証情報をホストの ~/.config/gh と共有して永続化します。gh auth login はホストで一度だけで済みます。",
    "mounts": [
        {
            "source": "${localEnv:HOME}/.config/gh",
            "target": "/var/gh-host-config",
            "type": "bind"
        }
    ],
    "containerEnv": {
        "GH_CONFIG_DIR": "/var/gh-host-config"
    },
    "postCreateCommand": "sudo -n /usr/local/bin/gh-init",
    "dependsOn": {
        "ghcr.io/devcontainers/features/github-cli": {}
    }
}
