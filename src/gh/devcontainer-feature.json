{
    "name": "GitHub CLI",
    "id": "gh",
    "version": "1.5.0",
    "description": "GitHub CLI を導入し、認証情報を永続化します。コンテナ内で gh auth login を一度行えば、再ビルド越し・全 DevContainer で共有されます。",
    "mounts": [
        {
            "source": "${localEnv:HOME}/.config/gh-devcontainers",
            "target": "/var/gh-config",
            "type": "bind"
        }
    ],
    "containerEnv": {
        "GH_CONFIG_DIR": "/var/gh-config"
    },
    "postCreateCommand": "sudo -n /usr/local/bin/gh-init",
    "dependsOn": {
        "ghcr.io/devcontainers/features/github-cli": {}
    }
}
