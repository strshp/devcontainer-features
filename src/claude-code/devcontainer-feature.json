{
    "name": "Claude Code",
    "id": "claude-code",
    "version": "2.4.1",
    "description": "Claude Code の認証情報・設定をホストの ~/.claude と共有し、会話などの実行時状態をリポジトリ単位で永続化します。",
    "dependsOn": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "mounts": [
        {
            "source": "${localEnv:HOME}/.claude",
            "target": "/var/claude-code-host",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.claude.json",
            "target": "/var/claude-code-host-claude-json",
            "type": "bind"
        }
    ],
    "postCreateCommand": "sudo -n /usr/local/bin/claude-code-init '${containerWorkspaceFolder}'"
}
